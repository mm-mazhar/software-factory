# Upstash Box API Key
# Get this from: https://console.upstash.com/box
UPSTASH_BOX_API_KEY=

# GitHub Fine-Grained Token
# Resource owner: mm-mazhar (your account)
# Repository access: mm-mazhar/software-factory + mm-mazhar/cli
# Permissions: Contents (read/write), Pull requests (read/write), Issues (read/write)
FACTORY_GITHUB_TOKEN=

# Claude Code OAuth Token
# Get this by running: claude setup-token
# (in a real terminal with browser access)
CLAUDE_CODE_OAUTH_TOKEN=
